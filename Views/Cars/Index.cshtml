@model List<CarRentalApplication.Models.Car>
@{
    ViewData["Title"] = "Available Cars";
}
<h1>Available Cars</h1>
<p>Select a car for booking</p>

@if (Model.Count == 0)
{
    <p>No Avaliable Car </p>
}
else
{
    <div class="row">
        @foreach (var car in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card p-3">
                    <h5>@car.Name</h5>

                    <p>Price: PKR @car.PricePerDay per day</p>

                    <p>Available</p>

                    <form asp-controller="Cars" asp-action="Book" method="post">
                        <input type="hidden" name="id" value="@car.Id" />
                        <button type="submit" class="btn btn-primary">Book Car</button>
                    </form>
                </div>
            </div>
        }
    </div>
}